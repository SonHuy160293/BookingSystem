ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# Use the same values in Identity, Cinema, and the gateway. Replace placeholders.
Jwt__SecretKey=CHANGE_ME_32_PLUS_CHARACTERS_FOR_DEV_ONLY
Jwt__Issuer=Company.Project
Jwt__Audience=Company.Project.Api

# Override these for other environments. Wildcards are rejected.
Gateway__AllowedHosts__0=localhost
Gateway__AllowedHosts__1=127.0.0.1
Gateway__AllowedHosts__2=::1

Gateway__MaxRequestBodyBytes=10485760
Gateway__ConnectionTimeoutSeconds=5
Gateway__ActivityTimeoutSeconds=15
Gateway__RequestTimeoutSeconds=30

# Add Gateway__KnownProxies__0 only for the actual trusted ingress IP.
# In non-Development, configure HTTPS ingress and explicit Cors__AllowedOrigins.
