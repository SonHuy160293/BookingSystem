ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
DOTNET_ENVIRONMENT=Development
POSTGRES_DB=CinemaDb
POSTGRES_USER=cinema
POSTGRES_PASSWORD=CHANGE_ME_CINEMA_PASSWORD
ConnectionStrings__ApplicationDb=Host=cinema-postgres;Port=5432;Database=CinemaDb;Username=cinema;Password=CHANGE_ME_CINEMA_PASSWORD
PostgreSql__MaxRetryCount=3
PostgreSql__MaxRetryDelaySeconds=10
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost:4200
Cors__AllowedOrigins__2=http://localhost:5173

# Match Identity and the gateway. Replace every placeholder before running.
Jwt__SecretKey=CHANGE_ME_32_PLUS_CHARACTERS_FOR_DEV_ONLY
Jwt__Issuer=Company.Project
Jwt__Audience=Company.Project.Api
IdentityIntegration__BaseUrl=http://identity-upstream:8080
IdentityIntegration__ApiKey=CHANGE_ME_INTEGRATION_KEY
